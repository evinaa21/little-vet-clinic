{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Little Vet Clinic: Build",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/build.sh",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "Little Vet Clinic: Build & Run",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/build.sh --run",
      "group": "none",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Little Vet Clinic: Clean Build & Run",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/build.sh --clean --run",
      "group": "none",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Little Vet Clinic: Release Build",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/build.sh --release",
      "group": "none",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Little Vet Clinic: Make DMG",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/make_dmg.sh",
      "group": "none",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Little Vet Clinic: Publish to itch.io",
      "type": "shell",
      "command": "ITCH_USER=${input:itchUser} ${workspaceFolder}/scripts/publish_itch.sh",
      "group": "none",
      "problemMatcher": "$gcc"
    }
  ],
  "inputs": [
    {
      "id": "itchUser",
      "type": "promptString",
      "description": "Your itch.io username",
      "default": "evinaa21"
    }
  ]
}
